# Discord Webhooks für Bullis, Shoutouts und BGS-Events
DISCORD_BULLIS_WEBHOOK_PROD=https://discord.com/api/webhooks/your-webhook-url
DISCORD_SHOUTOUT_WEBHOOK_PROD=https://discord.com/api/webhooks/your-webhook-url
DISCORD_CONFLICT_WEBHOOK_PROD=https://discord.com/api/webhooks/your-webhook-url
DISCORD_BGS_WEBHOOK_PROD=https://discord.com/api/webhooks/your-webhook-url
