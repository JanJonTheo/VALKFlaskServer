API_KEY_PROD=your-secure-api-key
API_VERSION_PROD=1.8.0
SERVER_NAME_PROD="VALK FlaskServer BGS Data API"
SERVER_DESCRIPTION_PROD="BGS Data Collection API for Elite Dangerous - VALK FlaskServer with Event-Processing, Activities, Objectives and Discord-Integration"
SERVER_URL_PROD="https://your-production-server-url.com"
