# Include inside the existing valk-elite.de HTTPS server block.
# ANKe uses https://valk-elite.de as its API origin. This exact prefix goes to
# Flask; the dashboard's /api/remote-screen/* browser BFF stays on Next.js.
location ^~ /api/remote-screen/v1/ {
    client_max_body_size 9m;
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;
}
