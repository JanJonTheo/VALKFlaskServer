# Existing dashboard/API HTTPS virtual hosts also move from :443 to
# 127.0.0.1:8443 ssl proxy_protocol and use the real-IP directives below.
server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    server_name media.REPLACE.example;
    ssl_certificate /etc/letsencrypt/live/media.REPLACE.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/media.REPLACE.example/privkey.pem;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
