# TLS passthrough with original client addresses (LiveKit >=1.13.7).
global
    log stdout format raw local0
defaults
    mode tcp
    timeout connect 5s
    timeout client 1h
    timeout server 1h
frontend valk_tls
    bind :443
    bind [::]:443 v6only
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend turn_tls if { req.ssl_sni -i turn.REPLACE.example }
    default_backend valk_https
backend turn_tls
    server turn 127.0.0.1:5349 send-proxy-v2
backend valk_https
    server nginx 127.0.0.1:8443 send-proxy-v2
